# Every page is a real folder with its own index.html (export-site.js writes
# them), e.g. /manufacturing/cnc-machining-tolerances/index.html. Apache
# serves the folder's index.html and adds a missing trailing slash itself.
DirectoryIndex index.html

# One host: www.engineer-booklet.com → engineer-booklet.com (the canonical
# URLs in every page point at the bare domain; YouTube descriptions link www).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Serve the branded 404 page for any path that doesn't exist on the server
# (typos, stale external links, a page that was never published).
ErrorDocument 404 /404.html
